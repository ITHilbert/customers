{
    "name": "ithilbert/customer",
    "type": "library",
    "license": "MIT",
    "description": "Kundenverwaltung",
    "keywords": [
        "it-hilbert",
        "laravel",
        "homepage",
        "customer"
    ],
    "authors": [
        {
            "name": "Jörg Hilbert",
            "homepage": "https://www.it-hilbert.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "dev",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.0 || ^13.0",
        "ithilbert/laravel-kit": "^1.1",
        "yajra/laravel-datatables-oracle": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\Customer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\Customer\\CustomerServiceProvider"
            ],
            "aliases": {}
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\Customer\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
